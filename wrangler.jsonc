{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codebeacons",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "codebeacons"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EMPLOYEES",
      "id": "a1374667456f4cf290a03a78e39919e2",
      "preview_id": "bf8bef9de59c44a8831eb0ce8509fc41"
    }
  ]
}
